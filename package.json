{
	"name": "jimu",
	"version": "0.0.1",
	"devDependencies": {
		"@iconify-json/heroicons": "^1.2.3",
		"@iconify-json/tabler": "^1.2.42",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"@unocss/preset-icons": "^66.11.0",
		"dotenv": "^18.0.8",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"husky": "^9.1.7",
		"idb": "^8.0.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"unocss": "^66.11.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"private": true,
	"scripts": {
		"format": "prettier --write --plugin prettier-plugin-svelte 'src/**/*.{ts,js,svelte,css,json}'",
		"dev": "vite dev --port 3000 --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run"
	},
	"type": "module",
	"dependencies": {
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.0.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
